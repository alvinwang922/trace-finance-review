# Public Base44 app identifiers; these are included in the browser build.
# Never put service-role tokens or API keys here.
VITE_BASE44_APP_ID=
# Published Base44 app origin, used for user sign-in (https://your-app.base44.app).
VITE_BASE44_APP_BASE_URL=

# Bright Data SERP API — used by the dev and preview server (/api/serp).
# Server-side credentials; never prefix with VITE_ and never commit real values.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=
# Use your actual zone name, or a Google SERP scraper dataset ID.
# A dataset takes precedence when both are configured.
BRIGHTDATA_SERP_DATASET=
# Merchant location searches use the SERP local-results section.
# The Google Maps full-information dataset is for individual place URLs;
# it is not needed for Trace's free-text merchant searches.
